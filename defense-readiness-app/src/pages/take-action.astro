---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { TOC } from '../data/toc';

const starterSections = [
  { slug: 'child-centered-deterrence', label: 'Community Preparedness Self-Assessment', why: 'Score your household in 2 minutes.' },
  { slug: 'surveillance-detox', label: 'Surveillance Detox Checklist', why: 'Pick three items to do this weekend.' },
  { slug: 'faith-family-renewal', label: 'Renewal Pledge', why: 'Choose one commitment you can keep for 30 days.' },
];
---

<BaseLayout title="Take Action Today" description="Three things you can do right now, no account needed.">
  <header class="mb-8 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-green-700">Start here</p>
    <h1 class="mt-2 text-4xl font-bold text-slate-900">Three Things You Can Do Today</h1>
    <p class="mt-3 text-lg text-slate-600">No account needed. No downloads. Just pick one and start.</p>
  </header>

  <ol class="mb-12 grid gap-6 sm:grid-cols-3">
    {starterSections.map((s, i) => (
      <li class="rounded-xl border border-green-200 bg-green-50 p-5">
        <div class="text-3xl font-bold text-green-700">{i + 1}.</div>
        <h2 class="mt-2 text-lg font-semibold text-slate-800">{s.label}</h2>
        <p class="mt-1 text-sm text-slate-600">{s.why}</p>
        <a href={`/sections/${s.slug}`} class="mt-3 inline-block rounded-md bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700">Open the tool →</a>
      </li>
    ))}
  </ol>

  <section class="mb-12 rounded-xl border border-blue-200 bg-blue-50 p-6">
    <h2 class="text-xl font-semibold text-slate-800">Share one section with one person</h2>
    <p class="mt-2 text-sm text-slate-700">
      The biggest multiplier is personal. Pick the section that moved you most and send it to one
      friend, parent, pastor, or teacher. Every section page has share buttons at the top.
    </p>
  </section>

  <section class="mb-12">
    <h2 class="text-xl font-semibold text-slate-800">Go deeper — browse all 17 sections</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      {TOC.map((e) => (
        <li>
          <a href={`/sections/${e.slug}`} class="block rounded-lg border border-slate-200 bg-white p-3 text-sm hover:border-blue-400 hover:bg-slate-50">
            <span class="font-medium text-slate-800">{e.number}. {e.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
