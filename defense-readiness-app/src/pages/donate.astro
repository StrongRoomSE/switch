---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout title="Donate" description="Support this work through BCF.">
  <header class="mb-10 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-green-700">Support the work</p>
    <h1 class="mt-2 text-4xl font-bold text-slate-900">Donate to {SITE.donateTo}</h1>
    <p class="mt-3 text-lg text-slate-600">
      All donations supporting this doctrine, the tools, and the people doing the work on the
      ground go through <strong>{SITE.donateTo}</strong>.
    </p>
  </header>

  <section class="mx-auto mb-10 max-w-2xl rounded-xl border border-green-200 bg-green-50 p-6 text-center">
    <h2 class="text-xl font-semibold text-slate-800">Make a donation</h2>
    <p class="mt-3 text-slate-700">
      Donations support preparedness training, the rescue and recovery work described in these
      sections, and the continued development of the tools you see on this site.
    </p>
    {SITE.donateUrl ? (
      <a href={SITE.donateUrl} class="mt-5 inline-block rounded-md bg-green-600 px-6 py-3 text-base font-semibold text-white hover:bg-green-700">
        Give through {SITE.donateTo} →
      </a>
    ) : (
      <div class="mt-5">
        <p class="rounded-md border border-dashed border-amber-400 bg-white p-3 text-sm text-slate-700">
          Donation link coming soon. In the meantime, contact {SITE.donateTo} directly to give.
        </p>
      </div>
    )}
  </section>

  <section class="mx-auto mb-10 max-w-2xl">
    <h2 class="text-xl font-semibold text-slate-800">Other ways to help</h2>
    <ul class="mt-4 space-y-3">
      <li class="rounded-lg border border-slate-200 bg-white p-4">
        <strong class="text-slate-800">Share one section with one person.</strong>
        <p class="mt-1 text-sm text-slate-600">The single highest-leverage action most people can take.</p>
      </li>
      <li class="rounded-lg border border-slate-200 bg-white p-4">
        <strong class="text-slate-800">Complete the preparedness self-assessment</strong>
        <p class="mt-1 text-sm text-slate-600">in Section 3 and send it to your closest neighbors.</p>
      </li>
      <li class="rounded-lg border border-slate-200 bg-white p-4">
        <strong class="text-slate-800">Submit a win.</strong>
        <p class="mt-1 text-sm text-slate-600">Stories of what's working feed the movement. Use the form on the <a href="/wins" class="text-blue-700 hover:underline">Wins</a> page.</p>
      </li>
    </ul>
  </section>
</BaseLayout>
