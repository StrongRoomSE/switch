---
import BaseLayout from '../../components/layout/BaseLayout.astro';

const tools = [
  { href: '/tools/local-resources', title: 'Find Local Resources', blurb: 'National hotlines + your state\'s key resources in one view.' },
  { href: '/tools/organizations', title: 'Organization Directory', blurb: 'Vetted organizations doing the work. Volunteer, donate, or learn.' },
  { href: '/tools/weekly-action', title: 'Weekly Action Calendar', blurb: '52 small actions, one per week. Keep momentum all year.' },
  { href: '/tools/social-summary', title: 'Per-Section Social Summary', blurb: 'One-line summaries you can copy and paste on social media.' },
  { href: '/wins', title: 'Share Your Story', blurb: 'Tell us what worked. Stories keep the movement moving.' },
];
---

<BaseLayout title="Tools" description="Extra tools for people who want to act.">
  <header class="mb-8 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Tools</p>
    <h1 class="mt-2 text-4xl font-bold text-slate-900">Act. Share. Keep going.</h1>
    <p class="mt-3 text-lg text-slate-600">
      Extra tools beyond the 17 sections — for people who want to do, not just read.
    </p>
  </header>

  <ul class="grid gap-5 sm:grid-cols-2">
    {tools.map((t) => (
      <li>
        <a href={t.href} class="flex h-full flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
          <h2 class="text-lg font-semibold text-slate-800">{t.title} →</h2>
          <p class="mt-2 text-sm text-slate-600">{t.blurb}</p>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
