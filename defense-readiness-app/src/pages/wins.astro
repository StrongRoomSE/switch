---
import BaseLayout from '../components/layout/BaseLayout.astro';
import ShareYourWin from '../components/ShareYourWin.tsx';
import { wins } from '../data/tools/wins';

const tagColor: Record<string, string> = {
  Rescue: 'bg-red-100 text-red-800',
  Preparedness: 'bg-blue-100 text-blue-800',
  Community: 'bg-purple-100 text-purple-800',
  Policy: 'bg-amber-100 text-amber-800',
  Family: 'bg-green-100 text-green-800',
  Education: 'bg-indigo-100 text-indigo-800',
};
---

<BaseLayout title="Wins" description="What's actually working — stories of families, schools, and communities using these tools.">
  <header class="mb-8 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-green-700">Momentum</p>
    <h1 class="mt-2 text-4xl font-bold text-slate-900">Wins</h1>
    <p class="mt-3 text-lg text-slate-600">
      What's actually working. Real families, schools, and communities using these tools.
    </p>
  </header>

  <ul class="mb-12 grid gap-5 sm:grid-cols-2">
    {wins.map((w) => (
      <li class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between gap-2">
          {w.tag && <span class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${tagColor[w.tag] ?? 'bg-slate-100 text-slate-700'}`}>{w.tag}</span>}
          {w.date && <span class="text-xs text-slate-400">{w.date}</span>}
        </div>
        <h2 class="mt-2 text-lg font-semibold text-slate-800">{w.title}</h2>
        <p class="mt-2 text-sm text-slate-700">{w.story}</p>
        {w.source && <p class="mt-2 text-xs text-slate-500">— {w.source}</p>}
      </li>
    ))}
  </ul>

  <ShareYourWin client:load />
</BaseLayout>
